# Kopieren nach .env und ausfüllen:  cp .env.example .env
# Die .env kommt nie in Git.

# Zufällige Strings, z. B. mit:  openssl rand -hex 32
JWT_SECRET=
POSTGRES_PASSWORD=

# Meta-App → App-Einstellungen → Allgemeines → App-Geheimcode
FACEBOOK_APP_SECRET=

# Cloudflare → Zero Trust → Networks → Tunnels → dein Tunnel → Docker-Befehl: alles nach "--token "
TUNNEL_TOKEN=

# Nach dem Anlegen deines Postiz-Accounts auf true setzen, dann: docker compose up -d
DISABLE_REGISTRATION=false

# Reel-Rotation: Postiz → Settings → Public API → API-Key kopieren
POSTIZ_API_KEY=

# Optional, für Caption-Varianten: https://platform.claude.com → API Keys
ANTHROPIC_API_KEY=
